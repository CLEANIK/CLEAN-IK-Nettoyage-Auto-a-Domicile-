Options -Indexes -MultiViews

# ── SPA routing (React) ────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass through existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → index.html
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# ── Security headers ───────────────────────────────────
<IfModule mod_headers.c>
  # Allow embedding in iframes from any domain (needed for WordPress embed)
  # X-Frame-Options is intentionally NOT set to allow cross-origin iframes
  Header always unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors *"

  # CORS: needed for PWA service worker and fonts
  Header always set Access-Control-Allow-Origin "*"

  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# ── Cache: long TTL for hashed assets ─────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>

# ── Gzip compression ───────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── MIME types ─────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript    .js
  AddType text/css                  .css
</IfModule>
